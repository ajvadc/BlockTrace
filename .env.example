# Etherscan API configuration (Multi-chain EVM supported via chainid)
ETHERSCAN_API_KEY=GPI1UCH9HW3A2X8J4WMKRPQ9A4IW37ADAK

# Database configuration
# DB_BACKEND options:
#   auto   - Attempt Neo4j connection; if unavailable, automatically fall back to local SQLite engine
#   neo4j  - Strictly require Neo4j graph database
#   sqlite - Use embedded local SQLite graph engine (zero external dependencies)
DB_BACKEND=auto

# Neo4j Graph Database
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=Aasifraz56
NEO4J_DATABASE=neo4j

# SQLite Graph Engine (when using sqlite or auto-fallback)
SQLITE_DB_PATH=blocktrace.db
